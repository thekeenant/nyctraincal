{
  "name": "NYC Train Cal",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers-contrib/features/protoc:1": {}
  },
  "runArgs": [
    "--network=web_default",
    "--network-alias=nyctraincal-dev"
  ],
  "containerEnv": {
    "PORT": "3000",
    "GTAG_ID": "G-DEVLOCAL",
    "APP_ENV": "development",
    "CARGO_HOME": "/home/vscode/.cargo"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "tamasfe.even-better-toml",
        "serayuzgur.crates",
        "vadimcn.vscode-lldb"
      ],
      "settings": {
        "rust-analyzer.checkOnSave.command": "clippy",
        "rust-analyzer.cargo.features": "all"
      }
    }
  },
  "postCreateCommand": "rustc --version && cargo --version && protoc --version",
  "postStartCommand": "sh .devcontainer/start-server.sh",
  "remoteUser": "vscode"
}
